# ---------------------------------------------------------------------------
# KORAH — landing pages monorepo
# Per-project rules live in each project's own .gitignore; this is the net that
# catches anything created at the root or in a new project folder.
# ---------------------------------------------------------------------------

# dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# build output
.next/
out/
build/
dist/
*.tsbuildinfo

# runtime data written by the backend (form submissions, events)
.data/

# environment — never commit real credentials
.env
.env.*
!.env.example

# logs and caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/
.vercel/
.eslintcache

# editors and OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
